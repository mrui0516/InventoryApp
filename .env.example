# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# never commit real secrets. settings.py loads .env on startup.

# Django. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-generated-random-key
# True for local use; set False when the app is exposed on a public URL,
# then run: python manage.py collectstatic --noinput
DEBUG=True

# Cloudinary (product image mirror). AUTO_SYNC off unless set to 1.
CLOUDINARY_CLOUD_NAME=bulvpmzg
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AUTO_SYNC=0

# Only when reached through a tunnel domain (comma-separated). Leave blank locally.
# ALLOWED_HOSTS=pos.example.com
# CSRF_TRUSTED_ORIGINS=https://pos.example.com
